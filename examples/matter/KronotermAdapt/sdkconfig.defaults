CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Enable OpenThread on the ESP32-C6's native 802.15.4 radio
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n

#disable lwip ipv6 autoconfig, Thread assigns the addresses
CONFIG_LWIP_IPV6_AUTOCONFIG=n

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Button
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_LONG_PRESS_TIME_MS=5000

# Matter over Thread only, so no Wi-Fi station or soft-AP
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# LwIP config for OpenThread
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y

# Thread devices register DNS-SD services over SRP instead of minimal mDNS
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y

# Root node, heat pump, heating loop 1 thermostat, the outdoor, flow and
# return temperature sensors and the hot water tank
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=7

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Matter device identification
# Vendor/product names and the version strings live in main/CHIPProjectConfig.h
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"
CONFIG_DEFAULT_DEVICE_HARDWARE_VERSION=0

CONFIG_MODBUS_BAUD_RATE=115200
CONFIG_MODBUS_SLAVE_ADDRESS=20